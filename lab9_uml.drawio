                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% INF1103 Lab 9 — corrected from PyUML Generator output\n%% 14 classes: 8 existing Lab 8 classes + 6 Lab 9 classes\n%% Corrections: aggregation, composition, association, interface realization, factory dependency.\nclassDiagram\ndirection TB\n  %% module: can_be_shipped\n  namespace can_be_shipped {\n    class C1[\&quot;can_be_shipped.CanBeShipped\&quot;] {\n      &lt;&lt;abstract&gt;&gt;\n      +calculate_shipping_cost() float*\n    }\n  }\n  %% module: digital_product\n  namespace digital_product {\n    class C2[\&quot;digital_product.DigitalProduct\&quot;] {\n      -download_size\n      +init(product_id: str, name: str, price: float, stock: int, download_size: float, supplier: Supplier) None\n      +get_download_size() float\n      +display_information() None\n      +get_fulfilment_info() str\n    }\n  }\n  %% module: discount_strategy\n  namespace discount_strategy {\n    class C3[\&quot;discount_strategy.BulkDiscount\&quot;] {\n      -float threshold\n      -float amount\n      +init(threshold: float, amount: float) None\n      +apply(total: float) float\n    }\n    class C4[\&quot;discount_strategy.DiscountStrategy\&quot;] {\n      &lt;&lt;abstract&gt;&gt;\n      +apply(total: float) float*\n    }\n    class C5[\&quot;discount_strategy.NoDiscount\&quot;] {\n      +apply(total: float) float\n    }\n    class C6[\&quot;discount_strategy.PercentageDiscount\&quot;] {\n      -float percentage\n      +init(percentage: float) None\n      +apply(total: float) float\n    }\n    class C7[\&quot;discount_strategy.StudentDiscount\&quot;] {\n      +apply(total: float) float\n    }\n  }\n  %% module: inventory\n  namespace inventory {\n    class C8[\&quot;inventory.Inventory\&quot;] {\n      -list~Product~ products\n      +init() None\n      +add_product(product: Product) bool\n      +find_product(product_id: str) Product_or_None\n      +search_product(product_id: str) Product_or_None\n      +remove_product(product_id: str) bool\n      +display_all() None\n      +get_products() list~Product~\n    }\n  }\n  %% module: order\n  namespace order {\n    class C9[\&quot;order.Order\&quot;] {\n      -str order_id\n      -list~OrderLine~ order_lines\n      -DiscountStrategy discount_strategy\n      +init(order_id: str, discount_strategy: DiscountStrategy_or_None) None\n      +get_order_id() str\n      +add_order_line(product: Product, quantity: int) None\n      +get_order_lines() tuple~OrderLine_many~\n      +remove_order_line(product_id: str) bool\n      +set_discount(discount_strategy: DiscountStrategy) None\n      +calculate_total() float\n    }\n  }\n  %% module: order_line\n  namespace order_line {\n    class C10[\&quot;order_line.OrderLine\&quot;] {\n      +Product product\n      +int quantity\n      +init(product: Product, quantity: int) None\n      +calculate_subtotal() float\n    }\n  }\n  %% module: physical_product\n  namespace physical_product {\n    class C11[\&quot;physical_product.PhysicalProduct\&quot;] {\n      -weight\n      +init(product_id: str, name: str, price: float, stock: int, weight: float, supplier: Supplier) None\n      +get_weight() float\n      +display_information() None\n      +get_fulfilment_info() str\n      +calculate_shipping_cost() float\n    }\n  }\n  %% module: product\n  namespace product {\n    class C12[\&quot;product.Product\&quot;] {\n      &lt;&lt;abstract&gt;&gt;\n      -id\n      -name\n      -price\n      -stock\n      -Supplier supplier\n      +get_fulfilment_info() str*\n      +init(product_id: str, name: str, price: float, stock: int, supplier: Supplier) None\n      +get_supplier() Supplier\n      +get_id() str\n      +get_name() str\n      +get_price() float\n      +get_stock() int\n      +update_stock(new_stock: int) None\n      +display_information() None\n    }\n  }\n  %% module: product_factory\n  namespace product_factory {\n    class C13[\&quot;product_factory.ProductFactory\&quot;] {\n      +create(product_type: str, product_id: str, name: str, price: float, stock_quantity: int, supplier: Supplier, weight: float_or_None, download_size: float_or_None) Product$\n    }\n  }\n  %% module: supplier\n  namespace supplier {\n    class C14[\&quot;supplier.Supplier\&quot;] {\n      -supplier_id\n      -name\n      -contact_email\n      +init(supplier_id: str, name: str, contact_email: str) None\n      +get_supplier_id() str\n      +get_name() str\n      +get_contact_email() str\n      +display_information() None\n    }\n  }\n\n  %% Inheritance (hollow triangles pointing toward parents)\n  C12 &lt;|-- C2\n  C12 &lt;|-- C11\n  C4 &lt;|-- C3\n  C4 &lt;|-- C5\n  C4 &lt;|-- C6\n  C4 &lt;|-- C7\n\n  %% CanBeShipped abstract interface/contract (virtual subclass registration)\n  C1 &lt;|.. C11\n\n  %% Lab 8 relationships\n  C8 \&quot;0..1\&quot; o-- \&quot;0..*\&quot; C12 : contains\n  C9 \&quot;1\&quot; *-- \&quot;0..*\&quot; C10 : owns\n  C10 \&quot;0..*\&quot; --&gt; \&quot;1\&quot; C12 : product\n  C14 \&quot;1\&quot; -- \&quot;0..*\&quot; C12 : supplies\n\n  %% Lab 9 relationships\n  C9 \&quot;0..*\&quot; --&gt; \&quot;1\&quot; C4 : uses\n  C13 ..&gt; C12 : «creates»\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Nukp25PWrFlZqCEC3HLx-0">
