                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Generated by PyUML Generator. Manual changes may be overwritten.\nclassDiagram\ndirection TB\n  %% module: can_be_shipped\n  namespace can_be_shipped {\n    class C1[\&quot;can_be_shipped.CanBeShipped\&quot;] {\n      &lt;&lt;abstract&gt;&gt;\n      +calculate_shipping_cost() float*\n    }\n  }\n  %% module: digital_product\n  namespace digital_product {\n    class C2[\&quot;digital_product.DigitalProduct\&quot;] {\n      -download_size\n      +init(product_id: str, name: str, price: float, stock: int, download_size: float, supplier: Supplier) None\n      +get_download_size() float\n      +display_information() None\n      +get_fulfilment_info() str\n    }\n  }\n  %% module: inventory\n  namespace inventory {\n    class C3[\&quot;inventory.Inventory\&quot;] {\n      -list~Product~ products\n      +init() None\n      +add_product(product: Product) bool\n      +find_product(product_id: str) Product_or_None\n      +search_product(product_id: str) Product_or_None\n      +remove_product(product_id: str) bool\n      +display_all() None\n      +get_products() list~Product~\n    }\n  }\n  %% module: order\n  namespace order {\n    class C4[\&quot;order.Order\&quot;] {\n      -str order_id\n      -list~OrderLine~ order_lines\n      +init(order_id: str) None\n      +get_order_id() str\n      +add_order_line(product: Product, quantity: int) None\n      +get_order_lines() tuple~OrderLine_many~\n      +remove_order_line(product_id: str) bool\n      +calculate_total() float\n    }\n  }\n  %% module: order_line\n  namespace order_line {\n    class C5[\&quot;order_line.OrderLine\&quot;] {\n      +Product product\n      +int quantity\n      +init(product: Product, quantity: int) None\n      +calculate_subtotal() float\n    }\n  }\n  %% module: physical_product\n  namespace physical_product {\n    class C6[\&quot;physical_product.PhysicalProduct\&quot;] {\n      -weight\n      +init(product_id: str, name: str, price: float, stock: int, weight: float, supplier: Supplier) None\n      +get_weight() float\n      +display_information() None\n      +get_fulfilment_info() str\n      +calculate_shipping_cost() float\n    }\n  }\n  %% module: product\n  namespace product {\n    class C7[\&quot;product.Product\&quot;] {\n      &lt;&lt;abstract&gt;&gt;\n      -id\n      -name\n      -price\n      -stock\n      -Supplier supplier\n      +get_fulfilment_info() str*\n      +init(product_id: str, name: str, price: float, stock: int, supplier: Supplier) None\n      +get_supplier() Supplier\n      +get_id() str\n      +get_name() str\n      +get_price() float\n      +get_stock() int\n      +update_stock(new_stock: int) bool\n      +display_information() None\n    }\n  }\n  %% module: supplier\n  namespace supplier {\n    class C8[\&quot;supplier.Supplier\&quot;] {\n      -supplier_id\n      -name\n      -contact_email\n      +init(supplier_id: str, name: str, contact_email: str) None\n      +get_supplier_id() str\n      +get_name() str\n      +get_contact_email() str\n      +display_information() None\n    }\n  }\n  C7 &lt;|-- C2\n  C3 --&gt; \&quot;0..*\&quot; C7 : __products\n  C4 --&gt; \&quot;0..*\&quot; C5 : __order_lines\n  C5 --&gt; \&quot;1\&quot; C7 : product\n  C7 &lt;|-- C6\n  C7 --&gt; \&quot;1\&quot; C8 : __supplier\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EZbXeL6wykt-1rTO-v3V-1">
