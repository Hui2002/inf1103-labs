      +display_information() None
      +get_fulfilment_info() str
    }
  }
  %% module: discount_strategy
  namespace discount_strategy {
    class C3["discount_strategy.BulkDiscount"] {
      -float threshold
      -float amount
      +init(threshold: float, amount: float) None
      +apply(total: float) float
    }
    class C4["discount_strategy.DiscountStrategy"] {
      <<abstract>>
      +apply(total: float) float*
    }
    class C5["discount_strategy.NoDiscount"] {
      +apply(total: float) float
    }
    class C6["discount_strategy.PercentageDiscount"] {
      -float percentage
      +init(percentage: float) None
      +apply(total: float) float
    }
    class C7["discount_strategy.StudentDiscount"] {
      +apply(total: float) float
    }
  }
  %% module: inventory
  namespace inventory {
    class C8["inventory.Inventory"] {
      -list~Product~ products
      +init() None
      +add_product(product: Product) bool
      +find_product(product_id: str) Product_or_None
      +search_product(product_id: str) Product_or_None
      +remove_product(product_id: str) bool
      +display_all() None
      +get_products() list~Product~
    }
  }
  %% module: order
  namespace order {
    class C9["order.Order"] {
      -str order_id
      -list~OrderLine~ order_lines
      -DiscountStrategy discount_strategy
      +init(order_id: str, discount_strategy: DiscountStrategy_or_None) None
      +get_order_id() str
      +add_order_line(product: Product, quantity: int) None
      +get_order_lines() tuple~OrderLine_many~
      +remove_order_line(product_id: str) bool
      +set_discount(discount_strategy: DiscountStrategy) None
      +calculate_total() float
    }
  }
  %% module: order_line
  namespace order_line {
    class C10["order_line.OrderLine"] {
      +Product product
      +int quantity
      +init(product: Product, quantity: int) None
      +calculate_subtotal() float
    }
  }
  %% module: physical_product
  namespace physical_product {
    class C11["physical_product.PhysicalProduct"] {
