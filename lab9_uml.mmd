      +init(product_id: str, name: str, price: float, stock: int, weight: float, supplier: Supplier) None
      +get_weight() float
      +display_information() None
      +get_fulfilment_info() str
      +calculate_shipping_cost() float
    }
  }
  %% module: product
  namespace product {
    class C12["product.Product"] {
      <<abstract>>
      -id
      -name
      -price
      -stock
      -Supplier supplier
      +get_fulfilment_info() str*
      +init(product_id: str, name: str, price: float, stock: int, supplier: Supplier) None
      +get_supplier() Supplier
      +get_id() str
      +get_name() str
      +get_price() float
      +get_stock() int
      +update_stock(new_stock: int) None
      +display_information() None
    }
  }
  %% module: product_factory
  namespace product_factory {
    class C13["product_factory.ProductFactory"] {
      +create(product_type: str, product_id: str, name: str, price: float, stock_quantity: int, supplier: Supplier, weight: float_or_None, download_size: float_or_None) Product$
    }
  }
  %% module: supplier
  namespace supplier {
    class C14["supplier.Supplier"] {
      -supplier_id
